; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scrapboys"
run/main_scene="uid://1nh8ghvdvg5m"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.17254902, 0.17254902, 0.17254902, 1)
boot_splash/image="uid://dqdnwf37cofn1"
config/icon="res://sprites/icon.svg"

[autoload]

ControllerGame="*uid://c34v4oe40eyqk"
Transition="*uid://fymlk7knt77j"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/dpi/allow_hidpi=false
mouse_cursor/custom_image="uid://blipaivgjbt0y"
mouse_cursor/tooltip_position_offset=Vector2(4, 6)

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
