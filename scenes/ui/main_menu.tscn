[sub_resource type="GDScript" id="GDScript_oa1go"]
script/source = "extends UIButton

func _on_pressed() -> void:
	super._on_pressed()
	ControllerGame.reset_progress()
	Transition.change_scene(\"res://scenes/garage.tscn\")
	ControllerGame.play_one_shot(preload(\"res://sounds/SFX 1/UI CLICK accept.ogg\"))
	ControllerGame.isMainMenu = false
"

